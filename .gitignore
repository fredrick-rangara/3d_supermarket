# Root level gitignore for 3D Supermarket

# Include both client and server node_modules
node_modules/
client/node_modules/
server/node_modules/

# Environment files
.env
.env.local
.env.development
.env.production
.env.test
client/.env
server/.env

# Build outputs
client/dist/
client/build/
server/dist/
server/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
.cache/

# Database
data/
dump/
*.sqlite
*.db

# Testing
coverage/
.nyc_output/

# Deployment
.vercel/
.netlify/
.heroku/

# Secrets (double protection)
**/secrets/
**/credentials/
**/*.pem
**/*.key

# Large media files (if stored in repo)
# Uncomment if you store assets in repo
# *.mp4
# *.mov
# *.psd
# *.blend

# Local development files
docker-compose.override.yml
*.local

# Ignore all .env files except example
.env*
!.env.example